FLASK_APP=app
FLASK_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5433/jeetsocial
SECRET_KEY=test-secret-key
ENABLE_RATE_LIMITING=1
ENABLE_MODERATION=1
ENABLE_KINDNESS_POINTS=1
ENABLE_AI_MODERATION=0
ENABLE_SIMILARITY_REMOTE=0
PORT=5678

# Admin Portal
ENABLE_ADMIN_PORTAL=1

# Admin Authentication
ADMIN_ID=admin
ADMIN_PASSWORD=admin123
ADMIN_REQUIRE_MFA=1
ADMIN_TEST_MFA_CODE=123456
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=86400
